<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/advanced_settings_title"
            android:textSize="26sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/adb_setup_help" />

        <CheckBox
            android:id="@+id/check_advanced_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/advanced_actions_enabled" />

        <CheckBox
            android:id="@+id/check_trigger_boot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/advanced_trigger_boot" />

        <CheckBox
            android:id="@+id/check_trigger_wake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/advanced_trigger_wake" />

        <TextView
            android:id="@+id/label_app_launch_delay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/edit_app_launch_delay"
            android:text="@string/app_launch_delay_label" />

        <EditText
            android:id="@+id/edit_app_launch_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:id="@+id/label_post_launch_delay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/edit_post_launch_delay"
            android:text="@string/post_launch_delay_label" />

        <EditText
            android:id="@+id/edit_post_launch_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:id="@+id/label_default_action_delay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/edit_default_action_delay"
            android:text="@string/default_action_delay_label" />

        <EditText
            android:id="@+id/edit_default_action_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:id="@+id/label_action_json"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/edit_action_json"
            android:text="@string/action_json_label" />

        <EditText
            android:id="@+id/edit_action_json"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/label_adb_host"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@id/edit_adb_host"
            android:text="@string/adb_host_label" />

        <EditText
            android:id="@+id/edit_adb_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1" />

        <TextView
            android:id="@+id/label_adb_port"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/edit_adb_port"
            android:text="@string/adb_port_label" />

        <EditText
            android:id="@+id/edit_adb_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLines="1" />

        <Button
            android:id="@+id/button_save_advanced_configuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/button_save_advanced_configuration" />

        <Button
            android:id="@+id/button_test_adb_connection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/button_test_adb_connection" />

        <Button
            android:id="@+id/button_run_action_sequence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/button_run_action_sequence" />

        <Button
            android:id="@+id/button_stop_action_sequence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="@string/button_stop_action_sequence" />

        <TextView
            android:id="@+id/text_adb_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/adb_status_idle"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
