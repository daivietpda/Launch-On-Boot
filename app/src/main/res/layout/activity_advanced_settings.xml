<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/advanced_settings_title" android:textSize="26sp" />
        <CheckBox android:id="@+id/check_advanced_enabled" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/advanced_actions_enabled" />
        <CheckBox android:id="@+id/check_trigger_boot" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/advanced_trigger_boot" />
        <CheckBox android:id="@+id/check_trigger_wake" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/advanced_trigger_wake" />
        <CheckBox android:id="@+id/check_restart_target_on_wake" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/restart_target_on_wake" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/restart_target_on_wake_help" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/app_launch_delay_label" />
        <EditText android:id="@+id/edit_app_launch_delay" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/post_launch_delay_label" />
        <EditText android:id="@+id/edit_post_launch_delay" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/default_action_delay_label" />
        <EditText android:id="@+id/edit_default_action_delay" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/target_launch_method_label" />
        <Spinner android:id="@+id/spinner_target_launch_method" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/target_launch_method_help" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/action_sequence_title" android:textSize="20sp" />
        <TextView android:id="@+id/text_action_sequence_summary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="@string/action_sequence_empty" />
        <Button android:id="@+id/button_edit_action_sequence" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/button_edit_action_sequence" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/adb_setup_help" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/adb_host_label" />
        <EditText android:id="@+id/edit_adb_host" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textUri" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/adb_port_label" />
        <EditText android:id="@+id/edit_adb_port" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number" android:maxLines="1" />
        <Button android:id="@+id/button_save_advanced_configuration" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="@string/button_save_advanced_configuration" />
        <Button android:id="@+id/button_test_adb_connection" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/button_test_adb_connection" />
        <Button android:id="@+id/button_test_target_launch" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/button_test_target_launch" />
        <Button android:id="@+id/button_request_home_role" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="@string/button_request_home_role" />
        <Button android:id="@+id/button_open_home_settings" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/button_open_home_settings" />
        <TextView android:id="@+id/text_adb_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/adb_status_idle" />
    </LinearLayout>
</ScrollView>
