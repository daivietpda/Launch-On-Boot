<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="32dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/action_sequence_editor_title" android:textSize="26sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/action_sequence_editor_description" />
        <TextView android:id="@+id/text_editor_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <LinearLayout android:id="@+id/action_list_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" />
        <Button android:id="@+id/button_add_action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/button_add_action" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <Button android:id="@+id/button_export_action_sequence" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/button_export_action_sequence" />
            <Button android:id="@+id/button_import_action_sequence" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/button_import_action_sequence" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <Button android:id="@+id/button_save_internal_backup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/button_save_internal_backup" />
            <Button android:id="@+id/button_open_internal_backups" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/button_open_internal_backups" />
        </LinearLayout>
        <Button android:id="@+id/button_save_action_sequence" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/button_save_action_sequence" />
        <Button android:id="@+id/button_run_editor_sequence" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/button_run_action_sequence" />
        <Button android:id="@+id/button_clear_action_sequence" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/button_clear_action_sequence" />
        <Button android:id="@+id/button_stop_editor_sequence" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/button_stop_action_sequence" />
    </LinearLayout>
</ScrollView>
